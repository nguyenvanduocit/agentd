{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node", "bun"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    // ../contract holds the generated client, outside this package: its imports resolve from here.
    "paths": { "socket.io-client": ["./node_modules/socket.io-client"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "eslint.config.js"]
}
