  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@types/bun": "^1.4.2",
    "typescript": "~6.0.2"
  }
}
